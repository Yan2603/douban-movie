# TMDB key — used by Nest server (not Flutter client)
TMDB_API_KEY=
# GHCR image must be lowercase (owner/repo).
GHCR_IMAGE=yan2603/douban-movie
IMAGE_TAG=latest

# Nest API / Postgres
PORT=3000
DATABASE_URL=postgres://douban:douban@localhost:5432/douban_movie
TYPEORM_SYNC=true
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
API_BASE_URL=/movie-api/api
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
